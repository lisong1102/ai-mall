# ---- LLM ----
# 注意：变量名必须与 apps/ai 代码中 process.env 读取的完全一致（区分大小写，勿随意改成全大写）
# DeepSeek 对话模型（https://platform.deepseek.com）
Deepseek_API_KEY=sk-xxx
# Kimi 对话模型（https://platform.moonshot.cn），可选
Kimi_API_KEY=sk-xxx
# 硅基流动 Embedding（https://cloud.siliconflow.cn），知识库 RAG 向量化用，BGE-large-zh 1024 维
SILICONFLOW_API_KEY=sk-xxx
# 智谱 Embedding-3（https://open.bigmodel.cn），备选 embedding 方案
ZHIPU_API_KEY=xxx

# ---- 数据库 ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=mall
POSTGRES_PASSWORD=mall
POSTGRES_DB=ai_mall
DATABASE_URL=postgresql://mall:mall@localhost:5432/ai_mall

# ---- Java 业务服务 ----
MALL_API_BASE=http://localhost:8080
# 后台登录 JWT：生产务必覆盖为随机长字符串（HS256 要求 ≥ 32 字节）；不填用 application.yml 内置开发默认值
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes-long
# token 有效期（毫秒），默认 86400000 = 24 小时
JWT_EXPIRATION=86400000
